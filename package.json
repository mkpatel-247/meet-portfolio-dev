{
  "name": "meet-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-port": "ng serve --host 0.0.0.0 --port 4200",
    "generate:embeddings": "npx ts-node scripts/generate-embeddings.ts",
    "build": "npm run build:ssr",
    "build:prod": "ng build --configuration production",
    "build:analyze": "ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/meet-portfolio/browser/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng run meet-portfolio:serve-ssr",
    "build:ssr": "ng build && ng run meet-portfolio:server",
    "serve:ssr": "node dist/meet-portfolio/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/platform-server": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/ssr": "^18.2.21",
    "aos": "^2.3.4",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "openai": "^6.13.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^3.4.18",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@types/aos": "^3.0.7",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "autoprefixer": "^10.4.21",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.5.2"
  }
}
