{
  "version": 2,
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "dist/meet-portfolio/server/server.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "dist/meet-portfolio/browser/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*\\..*)",
      "dest": "dist/meet-portfolio/browser/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dist/meet-portfolio/server/server.mjs"
    }
  ]
}